 class="hljs-number">2</span>); <span class="hljs-comment">% 测量的位置和速度</span><br><br><span class="hljs-keyword">for</span> k = <span class="hljs-number">2</span>:epoch<br>    <span class="hljs-comment">% 过程误差生成，符合正态分布P(w)～（0，Q）</span><br>    w1 = normrnd(<span class="hljs-number">0</span>, <span class="hljs-built_in">sqrt</span>(Q(<span class="hljs-number">1</span>, <span class="hljs-number">1</span>))); <span class="hljs-comment">% 位置过程误差</span><br>    w2 = normrnd(<span class="hljs-number">0</span>, <span class="hljs-built_in">sqrt</span>(Q(<span class="hljs-number">2</span>, <span class="hljs-number">2</span>))); <span class="hljs-comment">% 速度过程误差</span><br>    W = [w1, w2];<br>    X(k, :) = (A * X(k<span class="hljs-number">-1</span>, :)' + W')'; <span class="hljs-comment">% 更新实际位置、实际速度</span><br><span class="hljs-keyword">end</span><br><br><span class="hljs-keyword">for</span> k = <span class="hljs-number">1</span>:epoch<br>    <span class="hljs-comment">% 测量误差生成，符合正态分布P(v)～（0，R）</span><br>    v1 = normrnd(<span class="hljs-number">0</span>, <span class="hljs-built_in">sqrt</span>(R(<span class="hljs-number">1</span>, <span class="hljs-number">1</span>))); <span class="hljs-comment">% 位置观测误差</span><br>    v2 = normrnd(<span class="hljs-number">0</span>, <span class="hljs-built_in">sqrt</span>(R(<span class="hljs-number">2</span>, <span class="hljs-number">2</span>))); <span class="hljs-comment">% 速度观测误差</span><br>    V = [v1, v2];<br>    Z(k, :) = (H * X(k, :)' + V')'; <span class="hljs-comment">%更新测量位置、测量速度</span><br><span class="hljs-keyword">end</span><br><span class="hljs-keyword">for</span> k = <span class="hljs-number">2</span>:epoch<br>    <span class="hljs-comment">%预测</span><br>    P_ = A * P * A' + Q;<br>    Xa_(k, :) = (A * Xa(k<span class="hljs-number">-1</span>, :)')'; <span class="hljs-comment">% 先验</span><br>    <span class="hljs-comment">%校正</span><br>    K = P_ * H' * inv((H * P_)*H'+R);<br>    P = (I - K * H) * P_;<br>    Xa(k, :) = (Xa_(k, :)' + K * (Z(k, :)' - H * Xa_(k, :)'))';<br><span class="hljs-keyword">end</span><br><span class="hljs-built_in">plot</span>(<span class="hljs-number">1</span>:epoch, X(:, <span class="hljs-number">2</span>), <span class="hljs-string">'r*-'</span>, <span class="hljs-number">1</span>:epoch, Z(:, <span class="hljs-number">2</span>), <span class="hljs-string">'-b*'</span>, <span class="hljs-number">1</span>:epoch, Xa_(:, <span class="hljs-number">2</span>), <span class="hljs-string">'-g*'</span>, <span class="hljs-number">1</span>:epoch, Xa(:, <span class="hljs-number">2</span>), <span class="hljs-string">'-k*'</span>)<br><span class="hljs-built_in">hold</span> on<br><span class="hljs-built_in">legend</span>(<span class="hljs-string">'实际速度'</span>, <span class="hljs-string">'测量速度'</span>, <span class="hljs-string">'先验估计速度'</span>, <span class="hljs-string">'后验估计速度'</span>)<br></code></pre></div></td></tr></table></figure>
